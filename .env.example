# Copia este archivo como .env.local (en tu equipo) o carga cada variable en Netlify / Vercel.
# Las NEXT_PUBLIC_ son públicas; las demás son secretas y nunca llevan NEXT_PUBLIC_.

# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tareas programadas: una cadena larga al azar (openssl rand -hex 32)
CRON_SECRET=

# Llaves de clientes (si se deja vacía usa la clave de servicio; conviene una propia y no cambiarla después)
CLIENTES_LLAVE_SECRETO=

# Recibo de deliverys
RECIBO_EMPRESA_NOMBRE=
RECIBO_EMPRESA_RUC=

# Opcionales
RESEND_API_KEY=
RESEND_FROM=
NOTIFICACIONES_EMAIL=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Portal AF4 360°: reportes, comunicación y plataforma (migraciones 0937-0938). Todas opcionales y solo de servidor:
# sin ellas, cada función queda apagada con un aviso.
# Dirección pública del portal para los enlaces del correo (si falta: URL de Netlify o la de Vercel).
PORTAL_URL=
# IA de Anthropic: explicación de la variación del mes (Informe) y «Leer factura» (Libro de movimientos).
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-sonnet-4-5).
ANTHROPIC_MODEL=
# Resumen semanal por WhatsApp con una API compatible con Evolution API: POST {URL}/message/sendText/{instancia}.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCIA=
# Órdenes de Shopify por la Admin API: [{"tienda":"NOMBRE EN EL LIBRO","dominio":"x.myshopify.com","token":"shpat_…"}]
SHOPIFY_TIENDAS=
# QuickBooks Online (OAuth 2.0, solo lectura). App creada en developer.intuit.com; el Redirect URI debe ser exactamente
# https://<dominio del portal>/api/quickbooks/retorno. QBO_ENTORNO = sandbox (por defecto) o production.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENTORNO=sandbox
# Clave para cifrar los tokens en la base (AES-256-GCM): 32 bytes en hex o base64 (openssl rand -hex 32). Si cambia, hay que
# volver a conectar QuickBooks.
QBO_TOKEN_KEY=
# Monday.com: token personal (Perfil › Developers › My access tokens) de una cuenta con acceso al tablero de despachos.
MONDAY_API_TOKEN=
