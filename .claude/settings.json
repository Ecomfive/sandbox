{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PROJECT_DIR||process.cwd(),'.claude','hooks','impeccable-hook.cjs'))\"",
            "timeout": 15,
            "statusMessage": "Impeccable: revisando cambios de interfaz"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PROJECT_DIR||process.cwd(),'.claude','hooks','impeccable-hook.cjs'))\"",
            "timeout": 40,
            "statusMessage": "Impeccable: pasada final de diseño"
          }
        ]
      }
    ]
  }
}
