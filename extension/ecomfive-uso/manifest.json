{
  "manifest_version": 3,
  "name": "Ecomfive · Uso",
  "version": "0.1.0",
  "description": "Cuenta los minutos activos en Dropi, Effi, Drop y Shopify para saber qué traer al sistema Ecomfive. No guarda contenido de las páginas.",
  "permissions": ["alarms", "idle", "storage"],
  "host_permissions": [
    "https://mom-beta-proveduria.vercel.app/*",
    "https://app.dropi.pa/*",
    "https://app.dropi.cr/*",
    "https://app.dropi.mx/*",
    "https://effi.com.co/*",
    "https://*.effi.com.co/*",
    "https://app.soydrop.com/*",
    "https://admin.shopify.com/*"
  ],
  "background": { "service_worker": "fondo.js" },
  "action": { "default_title": "Ecomfive · Uso", "default_popup": "popup.html" }
}
