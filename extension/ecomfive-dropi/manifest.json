{
  "manifest_version": 3,
  "name": "Ecomfive · Dropi",
  "version": "0.5.0",
  "description": "Trae de Dropi al sistema Ecomfive los pedidos, la cartera, los retiros, el stock y las ventas («Actualizar Dropi»). Y los ganadores de Tu Winner para el Testing Lab. Solo lee.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://app.dropi.pa/*", "https://app.dropi.cr/*", "https://app.dropi.mx/*", "https://app.tuwinner.com/*"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    {
      "matches": ["https://mom-beta-proveduria.vercel.app/*"],
      "js": ["puente.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Ecomfive · Dropi", "default_popup": "popup.html" }
}
