# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# cache local del hook de impeccable, se regenera solo
.impeccable/hook.cache.json

# sesiones de Dropi guardadas localmente (cookies vivas, nunca committear)
.dropi-session-*.json
.dropi-explore-*.png
.dropi-downloads/

# lock de sesion local de Claude Code, no es parte del proyecto
.claude/scheduled_tasks.lock

# cache local del CLI de Supabase
supabase/.temp/
