# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# cache y registro locales del hook de impeccable, se regeneran solos
.impeccable/hook.cache.json
.impeccable/hook-runs.log
.impeccable/config.local.json

# ajustes personales de Claude Code (el hook compartido vive en .claude/settings.json)
.claude/settings.local.json

# sesiones de Dropi guardadas localmente (cookies vivas, nunca committear)
.dropi-session-*.json
.dropi-explore-*.png
.dropi-downloads/

# lock de sesion local de Claude Code, no es parte del proyecto
.claude/scheduled_tasks.lock

# cache local del CLI de Supabase
supabase/.temp/

# log de la tarea programada que renueva las sesiones de Dropi
mantener-sesiones-dropi.log
__pycache__/
